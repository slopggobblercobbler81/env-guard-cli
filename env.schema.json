{
  "$schema": "https://raw.githubusercontent.com/slopggobblercobbler81/env-guard-cli/main/schemas/env-guard.schema.json",
  "version": "1.0",
  "variables": {
    "APP_ENV": {
      "type": "string",
      "required": true,
      "enum": ["development", "staging", "production", "test"],
      "default": "development",
      "description": "Application execution environment"
    },
    "PORT": {
      "type": "port",
      "required": true,
      "default": "8080",
      "description": "Port on which the service listens"
    },
    "DATABASE_URL": {
      "type": "url",
      "required": true,
      "description": "Main relational database connection string"
    },
    "REDIS_URL": {
      "type": "url",
      "required": false,
      "default": "redis://localhost:6379/0",
      "description": "Redis cache and queue connection URL"
    },
    "API_SECRET_KEY": {
      "type": "string",
      "required": true,
      "secret": true,
      "min_length": 16,
      "description": "Cryptographic key for signing sessions and JWTs"
    },
    "DEBUG": {
      "type": "boolean",
      "required": false,
      "default": "false",
      "description": "Enable verbose diagnostic logs"
    },
    "MAX_CONNECTIONS": {
      "type": "integer",
      "required": false,
      "min": 1,
      "max": 1000,
      "default": "50",
      "description": "Maximum database pool connections"
    },
    "ADMIN_EMAIL": {
      "type": "email",
      "required": false,
      "description": "Alert notification recipient email"
    }
  }
}
