# ===================================================================
# Auto-generated environment template by env-guard-cli
# ===================================================================

# --- REQUIRED CONFIGURATION ---
# Application execution environment
# [required, type: string, enum: [development, staging, production, test]]
APP_ENV=development

# Port on which the service listens
# [required, type: port]
PORT=8080

# Main relational database connection string
# [required, type: url]
DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Cryptographic key for signing sessions and JWTs
# [required, type: string]
API_SECRET_KEY=<your_api_secret_key>


# --- OPTIONAL CONFIGURATION ---
# Redis cache and queue connection URL
# [type: url]
REDIS_URL=redis://localhost:6379/0

# Enable verbose diagnostic logs
# [type: boolean]
DEBUG=false

# Maximum database pool connections
# [type: integer]
MAX_CONNECTIONS=50

# Alert notification recipient email
# [type: email]
ADMIN_EMAIL=admin@example.com

